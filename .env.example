# Copy this file to .env.local and fill in your own Supabase project's
# values (Project Settings -> API in the Supabase dashboard).
#
# Never commit real credentials. .env.local is already git-ignored.
# The anon/public key is safe to expose in a frontend build — it is
# designed for that — but the service-role key must NEVER be used here.

VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
